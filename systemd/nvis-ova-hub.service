[Unit]
Description=NVIS-OVA CI/CD Hub portal
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/cicd-hub/runtime/config.toml
ConditionPathExists=%h/cicd-hub/runtime/secrets/portal-auth.json
ConditionPathExists=%h/cicd-hub/runtime/secrets/session-secret

[Service]
Type=simple
WorkingDirectory=%h/cicd-hub/worktrees/nvftp-sync-control-plane
ExecStart=%h/cicd-hub/runtime/venv/bin/nvis-integration --config %h/cicd-hub/runtime/config.toml hub-serve --web-root %h/cicd-hub/worktrees/nvftp-sync-control-plane/web --auth-records %h/cicd-hub/runtime/secrets/portal-auth.json --session-secret %h/cicd-hub/runtime/secrets/session-secret --credential-root %h/cicd-hub/runtime/secrets --host 0.0.0.0 --port 8787 --allow-network --insecure-http
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=%h/cicd-hub/runtime
TasksMax=128
LimitNOFILE=4096
MemoryMax=2G

[Install]
WantedBy=default.target
